# SmartRoute Google OAuth client. Create a separate client for this app.
SMARTROUTE_GOOGLE_CLIENT_ID=
SMARTROUTE_GOOGLE_CLIENT_SECRET=
SMARTROUTE_AUTH_SECRET=
SMARTROUTE_AUTH_URL=http://localhost:3000
SMARTROUTE_ADMIN_EMAILS=

# Restricted browser key for the SmartRoute Google Maps app.
NEXT_PUBLIC_SMARTROUTE_GOOGLE_MAPS_API_KEY=
# Advanced markers require a JavaScript Map ID. Falls back to
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID from .env, then Google's DEMO_MAP_ID.
NEXT_PUBLIC_SMARTROUTE_GOOGLE_MAPS_MAP_ID=

# Source database: use a dedicated read-only account and TLS.
NZMARIE_DATABASE_URL=
